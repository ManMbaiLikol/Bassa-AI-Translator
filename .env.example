DATABASE_URL=mysql+pymysql://root:@localhost:3306/bassa_translator?charset=utf8mb4

# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_with_secrets_token_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Moteur de traduction : dictionary | ml | llm | auto
ENGINE_TYPE=auto

# Clé API Anthropic (Claude) — laisser vide pour désactiver le moteur LLM
ANTHROPIC_API_KEY=

# Modèle Claude : claude-haiku-4-5-20251001 | claude-sonnet-4-6
CLAUDE_MODEL=claude-sonnet-4-6

# Google OAuth — Client ID (console.cloud.google.com)
GOOGLE_CLIENT_ID=

# CORS — origines autorisées (séparées par des virgules)
# Dev  : http://localhost:8000,http://127.0.0.1:8000
# Prod : https://ton-domaine.com
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Seuils ML (cosine similarity 0–1)
ML_HIGH_THRESHOLD=0.90
ML_MED_THRESHOLD=0.70
